require 'base64'

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Increase timeouts for heavy projects (Mapbox/Firebase)
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 1. Fetch certificates
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 2. Signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 3. Build Flutter (No Signing)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # 4. Build and Sign IPA
    # We store the output path to pass it explicitly to the upload step
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    ).path

    # 5. RE-DECODE KEY IMMEDIATELY BEFORE UPLOAD
    # This ensures the 'Bearer Token' is generated at the last possible second
    # and isn't mangled by GitHub's environment handling.
    decoded_key = Base64.decode64(ENV["APP_STORE_CONNECT_PRIVATE_KEY"])

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: decoded_key,
      in_house: false
    )

    # 6. Upload to TestFlight with EXPLICIT IPA path
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path, # Force use of the file we just built
      skip_waiting_for_build_processing: true,
      itms_transporter_type: "shell" # Force a more stable upload protocol for CI
    )
  end
end
