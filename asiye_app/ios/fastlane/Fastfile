require 'base64' # IMPORTANT: Ensure this is at the very top

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 1. Fetch certificates
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 2. Signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 3. Build Flutter (No Signing)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # 4. Build and Sign IPA (Workspace)
    # FIX: build_app returns a string directly, so we don't call .path
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 5. AUTHENTICATION
    # We decode your Base64 secret here to guarantee the key format is perfect.
    # Note: Ensure you followed the previous step to update your GitHub Secret to Base64!
    decoded_key = Base64.decode64(ENV["APP_STORE_CONNECT_PRIVATE_KEY"])

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: decoded_key,
      in_house: false
    )

    # 6. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path, # Explicitly use the path from the build_app step
      skip_waiting_for_build_processing: true
    )
  end
end
