require 'tmpdir'

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 1. CLEAN AND RECONSTRUCT PRIVATE KEY
    # This logic fixes keys that were mangled by copy-pasting into GitHub Secrets
    raw_key = ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s

    # Remove headers, footers, and all whitespace to get the raw base64 data
    clean_base64 = raw_key
      .gsub("-----BEGIN PRIVATE KEY-----", "")
      .gsub("-----END PRIVATE KEY-----", "")
      .gsub(/\s+/, "") # Removes all newlines, spaces, and tabs

    # Reconstruct the key with perfect 64-character line breaks (Apple's strict standard)
    reconstructed_key = "-----BEGIN PRIVATE KEY-----\n"
    reconstructed_key += clean_base64.scan(/.{1,64}/).join("\n")
    reconstructed_key += "\n-----END PRIVATE KEY-----\n"

    # 2. Setup API Key using the reconstructed string
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: reconstructed_key,
      in_house: false
    )

    # 3. Fetch certificates
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 4. Update signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 5. Build Flutter (No Signing)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # 6. Build and Sign IPA (Workspace)
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 7. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      team_id: "AC775BUGG5" # Force the specific team context
    )
  end
end
