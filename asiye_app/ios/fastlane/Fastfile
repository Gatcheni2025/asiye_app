require 'base64'

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 1. Fetch certificates (Using the app repo's 'certificates' branch)
    match(
      git_url: "https://github.com/Gatcheni2025/asiye_app",
      git_branch: "certificates",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 2. Update signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 3. Build Flutter (No Signing)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # 4. Build and Sign IPA (Workspace)
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 5. SMART AUTHENTICATION (Fixes the nil error and Bearer Token error)
    key_secret = ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.strip

    # If the secret doesn't have the "BEGIN" header, it's Base64. Decode it.
    if !key_secret.include?("BEGIN")
      key_secret = Base64.decode64(key_secret)
    end

    # Clean up the key data and enforce 64-character line breaks (Apple requirement)
    clean_data = key_secret.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/\s+/, "")
    formatted_key = "-----BEGIN PRIVATE KEY-----\n" +
                    clean_data.scan(/.{1,64}/).join("\n") +
                    "\n-----END PRIVATE KEY-----"

    # Use 'key_content' directly to avoid the 'IO.binread' crash
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_content: formatted_key,
      in_house: false
    )

    # 6. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
