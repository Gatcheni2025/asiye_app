default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 1. Setup API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      in_house: false
    )

    # 2. Fetch certificates
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 3. Explicitly map the Profile to the Target
    # We add 'profile_name' here to ensure Xcode knows which one has the Push/SignIn capabilities
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 4. Build Flutter (No Signing)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # 5. Build and Sign the IPA
    build_app(
      scheme: "Runner",
      project: "Runner.xcodeproj",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      # We force the PROVISIONING_PROFILE_SPECIFIER in xcargs as a final override
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye' -clonedSourcePackagesDirPath $(pwd)/../.spm_cache",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 6. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
