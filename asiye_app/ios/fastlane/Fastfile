require 'base64'

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. High timeouts for the slow build
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 2. Fetch certificates (match uses the ENV variables automatically)
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 3. Update signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 4. Build Flutter (No Signing)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # 5. Build and Sign IPA (Workspace)
    # Result is a string path, so we don't call .path
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 6. SELF-HEALING AUTHENTICATION
    # This block detects if your key is Base64 or Raw and fixes it for Apple
    raw_key_secret = ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.strip

    begin
      if !raw_key_secret.include?("BEGIN PRIVATE KEY")
        decoded_key = Base64.decode64(raw_key_secret)
      else
        decoded_key = raw_key_secret
      end
    rescue
      decoded_key = raw_key_secret
    end

    # Reconstruct key to strict PEM format (64 chars per line)
    clean_key_data = decoded_key.gsub("-----BEGIN PRIVATE KEY-----", "")
                                .gsub("-----END PRIVATE KEY-----", "")
                                .gsub(/\s+/, "")
    formatted_key = "-----BEGIN PRIVATE KEY-----\n" +
                    clean_key_data.scan(/.{1,64}/).join("\n") +
                    "\n-----END PRIVATE KEY-----"

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_content: formatted_key,
      in_house: false
    )

    # 7. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      team_id: "AC775BUGG5"
    )
  end
end
