require 'base64'
require 'tmpdir'

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. High timeouts for the slow build
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 2. Fetch certificates
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 3. Update signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 4. Build Flutter (No Signing)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # 5. Build and Sign IPA (Workspace)
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 6. FRESH AUTHENTICATION (The Fix for 38-min builds)
    # We decode the key and create a fresh token ONLY AFTER the build is done.
    decoded_key = Base64.decode64(ENV["APP_STORE_CONNECT_PRIVATE_KEY"])
    key_path = File.join(Dir.tmpdir, "auth_key.p8")
    File.write(key_path, decoded_key)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )

    # 7. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      team_id: "AC775BUGG5"
    )
  end
end
