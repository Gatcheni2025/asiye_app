require 'base64'
require 'shellwords'

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 1. Fetch certificates
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 2. Update signing settings
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 3. Keep Android's pubspec version (11.0.71+341) while building the
    # approved iOS marketing version. The workflow supplies an increasing
    # build number, independently of Android's versionCode.
    ios_version = ENV.fetch("ASIYE_IOS_MARKETING_VERSION", "")
    build_string = ENV.fetch("ASIYE_IOS_BUILD_NUMBER", "")
    unless ios_version.match?(/\A\d+\.\d+\.\d+\z/)
      UI.user_error!("A three-component iOS version is required.")
    end
    unless build_string.match?(/\A[1-9]\d*\z/) && build_string.to_i >= 46523
      UI.user_error!("The iOS build number must be numeric and >= 46523.")
    end
    UI.message("Building Asiye 11.0.71 source as iOS #{ios_version} (#{build_string})")

    # 4. Build Flutter without signing; archive and sign with Fastlane Match.
    sh("cd ../.. && flutter build ios --release --no-codesign --build-name=#{ios_version} --build-number=#{build_string}")

    # 5. Build and Sign IPA (Workspace)
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 6. SMART AUTHENTICATION (Fixes the nil error and Bearer Token error)
    key_secret = ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.strip

    # If the secret doesn't have the "BEGIN" header, it's Base64. Decode it.
    if !key_secret.include?("BEGIN")
      key_secret = Base64.decode64(key_secret)
    end

    # Clean up the key data and enforce 64-character line breaks (Apple requirement)
    clean_data = key_secret.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/\s+/, "")
    formatted_key = "-----BEGIN PRIVATE KEY-----\n" +
                    clean_data.scan(/.{1,64}/).join("\n") +
                    "\n-----END PRIVATE KEY-----"

    # Use 'key_content' directly to avoid the 'IO.binread' crash
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_content: formatted_key,
      in_house: false
    )

    # 7. Check the actual signed IPA's version, bundle ID, build and
    # export-compliance flag before anything is sent to Apple.
    # Fastlane evaluates this file from ios/fastlane, not the repository root.
    # Resolve the validator from this Fastfile's physical directory so the
    # signed IPA is verified before any upload occurs.
    validator = File.expand_path("../../scripts/verify_asiye_ios_metadata.py", __dir__)
    unless File.file?(validator)
      UI.user_error!("Missing signed IPA validator at #{validator}")
    end
    sh("python3 #{Shellwords.escape(validator)} --ipa #{Shellwords.escape(ipa_path.to_s)} --version #{Shellwords.escape(ios_version)} --build #{Shellwords.escape(build_string)}")

    # This lane runs only via the explicitly confirmed manual upload job.
    unless ENV["ASIYE_TESTFLIGHT_UPLOAD_CONFIRMED"] == "yes"
      UI.user_error!("Upload gate is closed; release confirmation is required.")
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
