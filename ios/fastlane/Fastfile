require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build, sign and upload the current Flutter release to TestFlight"
  lane :beta do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    # 1. Fetch App Store signing certificate/profile from the private match repo.
    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    # 2. Force the Runner target to use the match App Store profile.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    # 3. Read Flutter marketing version/build and create a CI-safe build number.
    project_root = File.expand_path("../..", __dir__)
    version_match = File.read(File.join(project_root, "pubspec.yaml")).match(/^version:\s+([^+]+)\+(\d+)/)

    UI.user_error!("Could not read Flutter version from pubspec.yaml") unless version_match

    version_name = version_match[1]
    current_build_number = version_match[2].to_i
    run_number = ENV.fetch("GITHUB_RUN_NUMBER", "0").to_i
    run_attempt = ENV.fetch("GITHUB_RUN_ATTEMPT", "1").to_i

    # Keep the checked-in Flutter build number as the floor, while ensuring
    # reruns cannot reuse an App Store Connect build number.
    ci_build_number = current_build_number + (run_number * 10) + run_attempt
    build_number = [current_build_number, ci_build_number].max

    UI.message("Building Asiye iOS #{version_name} (#{build_number})")

    # 4. Generate Flutter iOS release output before Xcode signing/archive.
    Dir.chdir(project_root) do
      sh(
        "flutter build ios --release --no-codesign " \
        "--build-name=#{version_name} --build-number=#{build_number}"
      )
    end

    # 5. Archive and export a signed App Store IPA.
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      output_directory: "build/ipa",
      output_name: "Asiye-#{version_name}-#{build_number}.ipa",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # 6. Build App Store Connect API key from the encrypted GitHub secret.
    key_secret = ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.strip
    UI.user_error!("APP_STORE_CONNECT_PRIVATE_KEY is empty") if key_secret.empty?

    if !key_secret.include?("BEGIN")
      key_secret = Base64.decode64(key_secret)
    end

    clean_data = key_secret
      .gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "")
      .gsub(/\s+/, "")

    formatted_key = "-----BEGIN PRIVATE KEY-----\n" +
                    clean_data.scan(/.{1,64}/).join("\n") +
                    "\n-----END PRIVATE KEY-----"

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_content: formatted_key,
      in_house: false
    )

    # 7. Upload the signed IPA to TestFlight.
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
