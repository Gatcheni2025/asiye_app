require 'base64'
require 'fileutils'
require 'shellwords'

default_platform(:ios)

platform :ios do
  desc "Build, verify, sign and upload the current Flutter release to TestFlight"
  lane :beta do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"

    setup_ci

    gh_pat = ENV["GH_PAT"].to_s.strip
    UI.user_error!("GH_PAT is empty") if gh_pat.empty?

    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs.git",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      readonly: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    project_root = File.expand_path("../..", __dir__)
    pubspec_path = File.join(project_root, "pubspec.yaml")
    version_match = File.read(pubspec_path).match(/^version:\s+([^+]+)\+(\d+)/)

    UI.user_error!("Could not read Flutter version from pubspec.yaml") unless version_match

    version_name = version_match[1]
    current_build_number = version_match[2].to_i
    run_number = ENV.fetch("GITHUB_RUN_NUMBER", "0").to_i
    run_attempt = ENV.fetch("GITHUB_RUN_ATTEMPT", "1").to_i

    # Use a unique monotonically increasing CI build while keeping pubspec as the floor.
    ci_build_number = current_build_number + (run_number * 10) + run_attempt
    build_number = [current_build_number, ci_build_number].max

    UI.message("Preparing Asiye iOS #{version_name} (#{build_number})")

    # Generate Flutter iOS build settings/assets using the exact release version.
    Dir.chdir(project_root) do
      sh(
        "flutter build ios --release --no-codesign " \
        "--build-name=#{Shellwords.escape(version_name)} " \
        "--build-number=#{Shellwords.escape(build_number.to_s)}"
      )
    end

    # Archive with the same version passed explicitly to Xcode.
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      output_directory: "build/ipa",
      output_name: "Asiye-#{version_name}-#{build_number}.ipa",
      clean: true,
      xcargs: [
        "FLUTTER_BUILD_NAME=#{version_name}",
        "FLUTTER_BUILD_NUMBER=#{build_number}",
        "MARKETING_VERSION=#{version_name}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=AC775BUGG5",
        "PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'"
      ].join(" "),
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    # Verify the actual IPA metadata before sending anything to Apple.
    verify_dir = File.expand_path("build/ipa_verify", __dir__)
    FileUtils.rm_rf(verify_dir)
    FileUtils.mkdir_p(verify_dir)

    sh("unzip -q -o #{Shellwords.escape(ipa_path)} -d #{Shellwords.escape(verify_dir)}")

    info_plist = Dir[File.join(verify_dir, "Payload", "*.app", "Info.plist")].first
    UI.user_error!("Could not find Info.plist inside the generated IPA") unless info_plist

    ipa_version = sh(
      "/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' #{Shellwords.escape(info_plist)}",
      log: false
    ).strip

    ipa_build = sh(
      "/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' #{Shellwords.escape(info_plist)}",
      log: false
    ).strip

    UI.message("Verified IPA metadata: version #{ipa_version}, build #{ipa_build}")

    if ipa_version != version_name
      UI.user_error!(
        "Refusing upload: IPA version is #{ipa_version}, expected #{version_name}"
      )
    end

    if ipa_build != build_number.to_s
      UI.user_error!(
        "Refusing upload: IPA build is #{ipa_build}, expected #{build_number}"
      )
    end

    key_secret = ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.strip
    UI.user_error!("APP_STORE_CONNECT_PRIVATE_KEY is empty") if key_secret.empty?

    if !key_secret.include?("BEGIN")
      key_secret = Base64.decode64(key_secret)
    end

    clean_data = key_secret
      .gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "")
      .gsub(/\s+/, "")

    formatted_key = "-----BEGIN PRIVATE KEY-----\n" +
                    clean_data.scan(/.{1,64}/).join("\n") +
                    "\n-----END PRIVATE KEY-----"

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_content: formatted_key,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
