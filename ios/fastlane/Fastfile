require 'base64'
require 'shellwords'
require 'json'

default_platform(:ios)

platform :ios do
  desc "Build the selected Asiye source, sign its IPA and upload it to TestFlight"
  lane :beta do
    unless ENV["ASIYE_TESTFLIGHT_UPLOAD_CONFIRMED"] == "yes"
      UI.user_error!("Upload gate is closed; release confirmation is required.")
    end
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"
    setup_ci

    ios_version = ENV.fetch("ASIYE_IOS_MARKETING_VERSION", "")
    source_version = ENV.fetch("ASIYE_SOURCE_VERSION", "")
    UI.user_error!("A three-component iOS version is required.") unless ios_version.match?(/\A\d+\.\d+\.\d+\z/)
    UI.user_error!("The selected mobile source must be 11.0.73+343.") unless source_version == "11.0.73+343"

    # Authenticate before compilation and select a fresh build above Apple's
    # current train and this workflow's unique run/attempt floor.
    key_secret = ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.strip.gsub('\n', "\n")
    key_secret = Base64.decode64(key_secret) unless key_secret.include?("BEGIN")
    clean_data = key_secret.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/\s+/, "")
    formatted_key = "-----BEGIN PRIVATE KEY-----\n" +
                    clean_data.scan(/.{1,64}/).join("\n") +
                    "\n-----END PRIVATE KEY-----"
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_content: formatted_key,
      duration: 1200,
      in_house: false
    )
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.asiyeapp.asiye",
      version: ios_version,
      initial_build_number: 93124
    )
    run_floor = 93125 + ENV.fetch("GITHUB_RUN_NUMBER", "0").to_i * 100 +
                ENV.fetch("GITHUB_RUN_ATTEMPT", "1").to_i
    build_string = [latest.to_i + 1, run_floor].max.to_s
    ENV["ASIYE_IOS_BUILD_NUMBER"] = build_string
    UI.message("Building Asiye #{source_version} as iOS #{ios_version} (#{build_string}); latest Apple build #{latest}")

    match(
      git_url: "https://github.com/Gatcheni2025/asiye-certs",
      type: "appstore",
      app_identifier: "com.asiyeapp.asiye",
      team_id: "AC775BUGG5",
      api_key: api_key,
      readonly: true
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "AC775BUGG5",
      bundle_identifier: "com.asiyeapp.asiye",
      profile_name: "match AppStore com.asiyeapp.asiye"
    )

    sh("cd ../.. && flutter build ios --release --no-codesign --build-name=#{ios_version} --build-number=#{build_string}")
    export_dir = File.expand_path("../release-output", __dir__)
    ipa_path = build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      export_team_id: "AC775BUGG5",
      output_directory: export_dir,
      output_name: "Asiye-#{source_version.tr('+', '-')}.ipa",
      xcargs: "DEVELOPMENT_TEAM=AC775BUGG5 PROVISIONING_PROFILE_SPECIFIER='match AppStore com.asiyeapp.asiye'",
      export_options: {
        provisioningProfiles: {
          "com.asiyeapp.asiye" => "match AppStore com.asiyeapp.asiye"
        }
      }
    )

    validator = File.expand_path("../../scripts/verify_asiye_ios_metadata.py", __dir__)
    UI.user_error!("Missing signed IPA validator at #{validator}") unless File.file?(validator)
    sh("python3 #{Shellwords.escape(validator)} --ipa #{Shellwords.escape(ipa_path.to_s)} --version #{Shellwords.escape(ios_version)} --build #{Shellwords.escape(build_string)}")
    File.write(File.join(export_dir, "release-info.json"), JSON.pretty_generate({
      source_version: source_version,
      source_commit: ENV["GITHUB_SHA"],
      ios_version: ios_version,
      ios_build_number: build_string,
      bundle_identifier: "com.asiyeapp.asiye",
      distribution: "TestFlight",
      live_payments_verified: false
    }))
    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |file|
        file.puts("ipa_path=#{ipa_path}")
        file.puts("ios_version=#{ios_version}")
        file.puts("ios_build_number=#{build_string}")
      end
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "Cleaner ride confirmation, Go offers from 65% of the reference fare and driver counter-offers. Review build; matching backend and real payment acceptance remain required."
    )
  end
end
